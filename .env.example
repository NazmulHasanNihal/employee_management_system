# ─────────────────────────────────────────────────────────────────────────────
# EMS (Employee Management System) Environment Variables Template
# 
# COPY THIS FILE TO `.env.local` or `.env` AND FILL IN YOUR REAL VALUES.
# NEVER COMMIT REAL KEYS OR SECRETS TO VERSION CONTROL.
# ─────────────────────────────────────────────────────────────────────────────

# ── SUPABASE DATABASE CONNECTION ─────────────────────────────────────────────
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Transaction pooler connection string (Port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct connection string for migration / session mode (Port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase API Endpoint & Public Key (Client & Server safe with RLS)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# Supabase Service Role Key (SERVER-ONLY — NEVER expose client-side)
NEXT_SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
# Legacy alias fallback
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# ── ENCRYPTION & AUTHENTICATION SECRETS ──────────────────────────────────────
# Secret key used for signing invite tokens (min 32 random characters)
INVITE_SECRET="<random-32-byte-secret>"

# Encryption key for 2FA / TOTP secrets stored at rest (AES-256-GCM)
TOTP_ENCRYPTION_KEY="<random-32-byte-secret>"

# Encryption key for National ID (NID) data stored at rest (AES-256-GCM)
NID_ENCRYPTION_KEY="<random-32-byte-secret>"

# Cron job authorization secret for automated API triggers
CRON_SECRET="<random-cron-secret-string>"

# ── SYSTEM ADMINISTRATION & OWNER CONFIG ────────────────────────────────────
# System owner email address (receives isOwner & CEO root privileges)
OWNER_EMAIL="owner@yourcompany.com"

# Default admin provisioning email & password (used by CLI admin scripts)
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="<strong-admin-password>"
ADMIN_NAME="System Administrator"

# Seed script password for demo accounts
DEMO_PASSWORD="<demo-account-password>"

# Optional IP Allowlist for admin route access (comma-separated IP list or CIDR)
# ADMIN_IP_ALLOWLIST="192.168.1.1,10.0.0.0/24"
# ADMIN_IP_DENY_MESSAGE="Access denied: IP not in authorized admin allowlist"

# ── PUBLIC SITE ORIGIN ───────────────────────────────────────────────────────
# Canonical app URL (used for invite links and redirect URLs)
NEXT_PUBLIC_SITE_URL="https://opshub.yourdomain.com"

# ── UPSTASH REDIS (Rate Limiting & Caching) ──────────────────────────────────
UPSTASH_REDIS_REST_URL="https://<upstash-redis-endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<upstash-redis-token>"

# ── WEB PUSH NOTIFICATIONS (VAPID Keys) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<vapid-public-key-base64>"
VAPID_PRIVATE_KEY="<vapid-private-key-base64>"
VAPID_SUBJECT="mailto:admin@yourcompany.com"

# ── POSTHOG PRODUCT ANALYTICS (Optional) ─────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="<posthog-project-key>"
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# ── SENTRY ERROR MONITORING & SOURCE MAPS (Optional) ─────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project-id>"
SENTRY_AUTH_TOKEN="<sentry-auth-token>"
SENTRY_ORG="<sentry-organization-slug>"
SENTRY_PROJECT="<sentry-project-slug>"

# ── STRIPE PAYMENTS (Optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_<stripe-pub-key>"
# STRIPE_SECRET_KEY="sk_live_<stripe-secret-key>"
# STRIPE_WEBHOOK_SECRET="whsec_<stripe-webhook-secret>"

# ── INTEGRATION WEBHOOKS (Optional) ───────────────────────────────────────────
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/XXXX"
# TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/XXXX"
# GOOGLE_WORKSPACE_API_KEY="<google-workspace-api-key>"

# ── EMAIL TRANSACTIONAL PROVIDER (Optional) ──────────────────────────────────
# RESEND_API_KEY="re_<resend-api-key>"
# EMAIL_FROM="noreply@yourcompany.com"
