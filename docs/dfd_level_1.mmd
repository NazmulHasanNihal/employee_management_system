flowchart TD
    classDef entity fill:#FF6B6B,stroke:#C92A2A,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;
    classDef process fill:#4D96FF,stroke:#1864AB,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;
    classDef datastore fill:#FF922B,stroke:#E8590C,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;

    EMP[Employee]:::entity
    HR[HR & Admin]:::entity
    BANK[Bank / MFS]:::entity

    P1((1.0\nIdentity &\nRegistry)):::process
    P2((2.0\nAttendance &\nLeave)):::process
    P3((3.0\nPayroll &\nCompensation)):::process
    P4((4.0\nSupport &\nHelpdesk)):::process
    P5((5.0\nAudit & Event\nSourcing)):::process

    D1[(D1: Employee DB)]:::datastore
    D2[(D2: Time & Leave DB)]:::datastore
    D3[(D3: Payroll Ledger)]:::datastore
    D4[(D4: Ticket DB)]:::datastore
    D5[(D5: Audit Ledger)]:::datastore

    EMP -- "Profile Data" --> P1
    P1 -- "Updates" --> D1

    EMP -- "Clock In/Out, Leave Req" --> P2
    P2 -- "Time Records" --> D2

    HR -- "Setup Compensation" --> P3
    P2 -- "Working Hours" --> P3
    P1 -- "Salary Base" --> P3

    P3 -- "Generate Payslips" --> D3
    P3 -- "Disburse Funds" --> BANK
    P3 -- "Payslips" --> EMP

    EMP -- "Submit Tickets" --> P4
    P4 -- "Ticket Data" --> D4

    P1 -. "Events" .-> P5
    P2 -. "Events" .-> P5
    P3 -. "Events" .-> P5
    P4 -. "Events" .-> P5

    P5 -- "Immutable Writes" --> D5
    D5 -- "Activity Reports" --> HR