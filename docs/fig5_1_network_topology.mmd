graph LR

    subgraph FRONTEND["Frontend Layer"]
        direction TB
        PWA[("🖥️ Client / Browser<br/>(PWA — Serwist)")]
        NEXT[("▲ Next.js 15<br/>(Vercel Edge)")]
    end

    subgraph BACKEND["Backend / API Layer"]
        direction TB
        TRPC[("🔌 tRPC Router<br/>(Server Actions)")]
    end

    subgraph DATA["Data Layer"]
        direction TB
        PRISMA[("🔷 Prisma ORM<br/>(Type-Safe Client)")]
        SUPABASE_DB[("🐘 Supabase PostgreSQL<br/>(Primary Database)")]
    end

    subgraph MICRO["Microservices Layer"]
        direction TB
        BIO[("🖐️ Biometric Hardware")]
        GO[("🔵 Go Microservice<br/>(Computational Engine)")]
        STORAGE[("☁️ Supabase Cloud Storage<br/>(PDF Output)")]
    end

    PWA -->|"HTTPS / JSON"| NEXT
    NEXT -->|"Server Actions"| TRPC
    TRPC -->|"Queries / Mutations"| PRISMA
    PRISMA -->|"SQL / Migrations"| SUPABASE_DB
    
    BIO -->|"Raw Biometric Data"| GO
    GO -->|"Push PDF Files"| STORAGE

