flowchart TB
    subgraph HR_ENTITIES ["HR Core Entities"]
        direction TB
        Employee["Employee<br/>employee_id PK"]
        AttendanceLog["AttendanceLog<br/>attendance_id PK<br/>employee_id FK"]
        HelpdeskTicket["HelpdeskTicket<br/>ticket_id PK<br/>employee_id FK"]
        PayrollStructure["PayrollStructure<br/>structure_id PK"]
        PayrollHead["PayrollHead<br/>head_id PK<br/>structure_id FK"]
    end

    subgraph LEDGER ["Independent Ledger"]
        AuditLog["AuditLog<br/>log_id PK<br/>(Isolated — No Connections)"]
    end

    Employee -->|"1 : N"| AttendanceLog
    Employee -->|"1 : N"| HelpdeskTicket
    PayrollStructure -->|"1 : N"| PayrollHead

    classDef coreEntity fill:#4F46E5,stroke:#1E1B4B,stroke-width:2px,color:#FFFFFF
    classDef childEntity fill:#DC2626,stroke:#991B1B,stroke-width:2px,color:#FFFFFF
    classDef payrollEntity fill:#059669,stroke:#064E3B,stroke-width:2px,color:#FFFFFF
    classDef payrollHeadEntity fill:#0891B2,stroke:#164E63,stroke-width:2px,color:#FFFFFF
    classDef auditEntity fill:#374151,stroke:#111827,stroke-width:2px,color:#F9FAFB,stroke-dasharray:5 5

    class Employee coreEntity
    class AttendanceLog childEntity
    class HelpdeskTicket childEntity
    class PayrollStructure payrollEntity
    class PayrollHead payrollHeadEntity
    class AuditLog auditEntity