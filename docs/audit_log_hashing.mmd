flowchart TD
    %% Vibrant color scheme with black text
    classDef input fill:#4F46E5,stroke:#1E1B4B,stroke-width:3px,color:#FFFFFF,font-family:Arial,sans-serif,font-weight:bold
    classDef process fill:#F59E0B,stroke:#92400E,stroke-width:3px,color:#000000,font-family:Arial,sans-serif,font-weight:bold
    classDef hash fill:#10B981,stroke:#065F46,stroke-width:3px,color:#000000,font-family:Arial,sans-serif,font-weight:bold
    classDef db fill:#EF4444,stroke:#7F1D1D,stroke-width:3px,color:#FFFFFF,font-family:Arial,sans-serif,font-weight:bold
    classDef connector fill:#8B5CF6,stroke:#4C1D95,stroke-width:2px,color:#FFFFFF,font-family:Arial,sans-serif,font-weight:bold

    subgraph Step1 ["STEP 1: GATHER INPUTS"]
        direction LR
        A["📄 NEW EVENT PAYLOAD<br/>(e.g., 'ADMIN_04 | UPDATE_SALARY | 65000')"]:::input
        B["🔗 PREVIOUS BLOCK'S HASH<br/>(H₀: '0000...0000')"]:::input
    end

    C["🔗 COMBINE PAYLOAD & PREVIOUS HASH<br/>(Concatenation Step)"]:::connector

    subgraph Step2 ["STEP 2: GENERATE CRYPTOGRAPHIC SIGNATURE"]
        direction LR
        D{"APPLY SHA-256 HASHING ALGORITHM"}:::process
        E["🔒 NEW COMPUTED HASH (H₁)<br/>('3a7c1e9f...4a6b')"]:::hash
    end

    subgraph Step3 ["STEP 3: IMMUTABLE STORAGE"]
        F[("💾 SAVE TO AUDITLOG DATABASE<br/>• Payload<br/>• Previous Hash<br/>• Current Hash")]:::db
    end

    A --> C
    B --> C
    C -->|"CREATES RAW STRING"| D
    D -->|"GENERATES SECURE FINGERPRINT"| E
    E -->|"STORE SECURELY"| F