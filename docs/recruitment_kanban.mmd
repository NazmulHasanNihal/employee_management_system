flowchart LR
    classDef header fill:#1E1B4B,stroke:#4F46E5,stroke-width:3px,color:#FFFFFF,font-family:Arial,sans-serif,font-weight:bold,font-size:14px
    classDef cardApplied fill:#DBEAFE,stroke:#1E40AF,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:600
