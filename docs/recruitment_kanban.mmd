    classDef cardHired fill:#FCE7F3,stroke:#9D174D,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:600
    classDef arrow fill:#4F46E5,stroke:#1E1B4B,stroke-width:3px,color:#FFFFFF,font-family:Arial,sans-serif,font-weight:bold
    classDef empty fill:#F1F5F9,stroke:#CBD5E1,stroke-width:1px,color:#94A3B8,font-family:Arial,sans-serif,font-style:italic

    subgraph Applied ["📥 APPLIED"]
