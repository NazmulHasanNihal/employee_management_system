graph LR

    subgraph CRUD["Standard Mutable CRUD"]
        direction TB
        C1[("🗄️ SQL Database<br/>employees table")]
        C2["<b>Step 1: Read</b><br/>SELECT * WHERE id=101<br/>salary = $50,000"]
        C3["<b>Step 2: UPDATE</b><br/>SET salary = $75,000<br/>WHERE id = 101"]
        C4["<b>Step 3: Overwrite</b><br/>Memory rewritten<br/>$50,000 destroyed"]
        C5["❌ <b>History Lost</b><br/>No audit trail<br/>Cannot recover"]
        C6["<b>Final State</b><br/>salary = $75,000"]
        C1 --> C2 --> C3 --> C4 --> C5 --> C6
    end

    subgraph LEDGER["Cryptographic Immutable Ledger"]
        direction TB
        L1[("📒 Append-Only<br/>Event Store")]
        L2["<b>Block #001 — Genesis</b><br/>EMPLOYEE_HIRED<br/>Salary: $50,000<br/>Hash: 0x7a9f2c...<br/>Previous: 00000000..."]
        L3["<b>Block #002 — Salary Updated</b><br/>SALARY_UPDATED<br/>$50,000 → $75,000<br/>Hash: 0x3b2e4a...<br/>Previous: 0x7a9f2c..."]
        L4["<b>Block #003 — Bonus Granted</b><br/>BONUS_GRANTED<br/>Amount: $10,000<br/>Hash: 0xd4f8a1...<br/>Previous: 0x3b2e4a..."]
        L5["✅ <b>Full Audit Trail</b><br/>All changes preserved<br/>Tamper-evident chain<br/>Replayable & verified"]
        L1 --> L2 --> L3 --> L4 -.-> L5
    end

