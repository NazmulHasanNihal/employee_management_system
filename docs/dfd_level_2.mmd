flowchart LR
    classDef entity fill:#FF6B6B,stroke:#C92A2A,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;
    classDef process fill:#4D96FF,stroke:#1864AB,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;
    classDef datastore fill:#FF922B,stroke:#E8590C,stroke-width:2px,color:#000000,font-family:Arial,sans-serif,font-weight:bold;

    HR[HR & Admin]:::entity
    BANK[Bank / MFS]:::entity

    D1[(D1: Employee DB)]:::datastore
    D2[(D2: Time & Leave DB)]:::datastore
    D3[(D3: Payroll Ledger)]:::datastore
    D5[(D5: Audit Ledger)]:::datastore

    P31((3.1\nFetch Salary &\nStructure)):::process
    P32((3.2\nCalculate Base &\nAllowances)):::process
    P33((3.3\nCalculate Taxes\n& Deductions)):::process
    P34((3.4\nGenerate Payslip\n& Ledger)):::process
    P35((3.5\nExecute Bank\nDisbursement)):::process

    HR -- "Trigger Payroll Batch" --> P31
    D1 -- "Base Salary, Bank Info" --> P31

    P31 -- "Salary Data" --> P32
    D2 -- "Leave/Lateness Data" --> P32

    P32 -- "Gross Salary" --> P33
    P33 -- "Net Payable" --> P34

    P34 -- "Save Record" --> D3
    P34 -- "Immutable Event" --> D5

    P34 -- "Payment Command" --> P35
    P35 -- "BEFTN/MFS Request" --> BANK
    BANK -- "TrxID Success" --> P35
    P35 -- "Finalize Status" --> D3